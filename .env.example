# Environment Configuration

# aMule Daemon External Connection Settings
AMULE_EC_PASSWORD=mule
AMULE_EC_HOST=localhost
AMULE_EC_PORT=4712
AMULE_CMD_PATH=amulecmd

# Nuxt Application Settings
NODE_ENV=development
NUXT_PORT=3000
# Live updates run on a second port, on their own WebSocket server. The browser is
# told this number, so whatever you set here has to be reachable at that same value
# from outside: in Docker, publish it as WS_PORT:WS_PORT, not host-only.
WS_PORT=3001

# --- Docker ------------------------------------------------------------------
# Three layouts, same image, picked by the compose file:
#
#   docker compose up -d                                 daemon + app together
#   docker compose -f docker-compose.web.yml up -d        app only, daemon elsewhere
#   docker compose -f docker-compose.split.yml up -d      one container each
#
# SERVICES decides what a container runs: all (default), web, or amule. It is set
# by the compose files, so it only needs changing for a hand-rolled `docker run`.

# Ports published on the host. WS_PORT is published on the same number on both
# sides, because it is also the port the browser is told to connect to.
# WEB_PORT=3000
# EC_PORT=4712
# ED2K_TCP_PORT=4662
# ED2K_UDP_PORT=4665
# KAD_UDP_PORT=4672

# Images to build or pull instead of the local defaults
# AMULE_NUXT_IMAGE=ghcr.io/juanmandev/amule-nuxt:latest
# AMULE_NUXT_WEB_IMAGE=ghcr.io/juanmandev/amule-nuxt:latest

# Where a daemon-only container binds External Connections (default 0.0.0.0 so
# the web container can reach it; the all-in-one image keeps it on loopback)
# AMULE_EC_BIND=0.0.0.0

# Bind mounts for the downloads, if you would rather not use Docker volumes
# AMULE_INCOMING=./downloads/incoming
# AMULE_TEMP=./downloads/temp

# --- Notifications -----------------------------------------------------------
# Where the VAPID key pair and the push subscriptions are stored. Mount this as a
# volume, or the keys are regenerated on every container rebuild and every
# browser has to grant notifications again.
# AMULE_DATA_DIR=/config/amule-nuxt

# Supply the key pair instead of letting the server generate one. Needed when
# several replicas serve the same users: a subscription is bound to the key it
# was created with. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
