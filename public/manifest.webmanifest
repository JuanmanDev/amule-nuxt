{
  "name": "aMule Nuxt",
  "short_name": "aMule",
  "description": "Web interface for an aMule daemon: downloads, uploads, shared files, servers, search and Kad.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111827",
  "theme_color": "#00dc82",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "ed2k",
      "url": "./handle-link?link=%s&scheme=ed2k"
    },
    {
      "protocol": "magnet",
      "url": "./handle-link?link=%s&scheme=magnet"
    }
  ],
  "shortcuts": [
    {
      "name": "Downloads",
      "url": "./downloads"
    },
    {
      "name": "Uploads",
      "url": "./uploads"
    },
    {
      "name": "Search",
      "url": "./search"
    }
  ]
}
