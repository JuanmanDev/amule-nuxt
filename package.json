{
  "name": "amule-nuxt",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3003 --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "install:amule:wsl2": "bash scripts/install-amule-wsl2.sh",
    "install:amule:linux": "bash scripts/install-amule-linux.sh",
    "configure:amule": "bash scripts/configure-amule.sh",
    "amule:test": "bash ./scripts/test-ec-connection.sh",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test test/e2e/offline.spec.ts",
    "typecheck": "nuxt typecheck",
    "lint:deps": "npm outdated || true"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@types/ws": "^8.18.1",
    "nuxt": "^4.2.1",
    "vue": "^3.5.24",
    "vue-router": "^5.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxtjs/mcp-toolkit": "^0.18.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "secure-exec": "^0.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wait-on": "^9.1.0",
    "zod": "^4.4.3"
  }
}
